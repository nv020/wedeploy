{
  "buildCommand": "pnpm --filter @workspace/wedeploy run build",
  "outputDirectory": "artifacts/wedeploy/dist/public",
  "installCommand": "pnpm install",
  "framework": null,
  "functions": {
    "artifacts/wedeploy/api/contact.ts": {
      "maxDuration": 10
    }
  },
  "rewrites": [
    { "source": "/api/contact", "destination": "/artifacts/wedeploy/api/contact" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
